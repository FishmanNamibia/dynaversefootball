NODE_ENV=development
PORT=5003
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dynaacademy
DEFAULT_CURRENCY=NAD
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_TOKEN_SECRET=change-this-in-production
AUTH_TOKEN_TTL_HOURS=12
EMAIL_FROM=billing@dynaverse.local

# SMTP (required for real system delivery)
# If credentials are missing and SMTP_SIMULATE=false, send attempts fail with config error.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_SIMULATE=false

# WhatsApp API (required for real system delivery)
# If credentials are missing and WHATSAPP_SIMULATE=false, send attempts fail with config error.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_DEFAULT_SENDER=
WHATSAPP_SIMULATE=false

ACADEMY_CONTACT_EMAIL=services@dynaverseinvestment.com
ACADEMY_CONTACT_PHONE=+264 81 299 4529
BANK_NAME=[Bank Name]
BANK_ACCOUNT_NAME=Dynaverse Football Academy
BANK_ACCOUNT_NUMBER=[XXXXXXX]
